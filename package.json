{
  "name": "agent-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "dev:server": "bun run --cwd packages/server dev",
    "dev:web": "bun run --cwd packages/web dev",
    "build": "bun run --cwd packages/web build",
    "start": "bun run --cwd packages/server start",
    "typecheck": "bun run --filter='*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "playwright-core": "^1.60.0",
    "typescript": "^5.7.2"
  }
}
